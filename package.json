{
  "dependencies": {
    "fastmcp": "^3.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "name": "mcp-searxng-public",
  "version": "1.3.0",
  "description": "An MCP server that queries public SearXNG instances, parsing HTML contents into a JSON result",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "mcp-searxng-public": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node ./scripts/chmod-if-unix.cjs",
    "report": "node ./scripts/test-searxng-servers.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwilkin/mcp-searxng-public.git"
  },
  "keywords": [
    "MCP",
    "SearXNG",
    "web search"
  ],
  "author": "Piotr Wilkin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pwilkin/mcp-searxng-public/issues"
  },
  "homepage": "https://github.com/pwilkin/mcp-searxng-public#readme"
}
